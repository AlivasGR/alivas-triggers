        "value": 1,
        "units": "minutes",
        "expiry": "turnStart",
        "expired": false
      },
      "description": "<p>Three illusory duplicates. When you're hit by an attack roll, a d6 is rolled per remaining duplicate automatically: if any rolls 3+, a duplicate is hit instead and destroyed. The spell ends when all three are destroyed. Attackers that are Blinded or have Blindsight or Truesight are unaffected.</p>",
      "flags": {
        "alivas-engine-of-triggers": {
          "triggers": [
            {
              "label": "Mirror Image",
              "event": "hit",
              "filter": [
                {
                  "o": "NOT",
                  "v": {
                    "k": "statuses.blinded",
                    "o": "gte",
                    "v": 1
                  }
                },
                {
                  "o": "NOT",
                  "v": {
                    "k": "attributes.senses.ranges.blindsight",
                    "o": "gt",
                    "v": 0
                  }
                },
                {
                  "o": "NOT",
                  "v": {
                    "k": "attributes.senses.ranges.truesight",
                    "o": "gt",
                    "v": 0
                  }
                }
              ],
              "action": {
                "type": "duplicates",
                "count": 3,
                "threshold": 3
              },
              "then": "removeWhenDepleted"
            }
          ]
        }
      },
