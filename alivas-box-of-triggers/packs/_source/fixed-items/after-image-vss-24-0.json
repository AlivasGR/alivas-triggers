  "effects": [
    {
      "name": "After Image",
      "img": "icons/magic/defensive/illusion-evasion-echo-purple.webp",
      "transfer": false,
      "statuses": [],
      "duration": {
        "value": 10,
        "units": "minutes",
        "expiry": "turnStart",
        "expired": false
      },
      "description": "<p>Lasts the spell's full 10 minutes. When you're hit by an attack roll, a d6 is rolled automatically: on 3+ the duplicate is hit instead and destroyed — this effect is then named <b>After Image (no duplicates)</b> and stops rolling. The duplicate reappears automatically if you move 15+ ft on your turn (in combat) or gain the Dodging status. Attackers that are Blinded or have Blindsight or Truesight are unaffected.</p>",
      "_id": "tlV6eIjdOxzrvNtZ",
      "type": "base",
      "system": {
        "changes": [],
        "origin": {
          "actor": null,
          "behavior": null,
