          "item": null,
          "message": null
        },
        "conditions": "{}",
        "magical": false,
        "rider": {
          "statuses": []
        }
      },
      "disabled": false,
      "start": null,
      "origin": null,
      "tint": "#ffffff",
      "showIcon": 1,
      "folder": null,
      "sort": 0,
      "flags": {
        "alivas-engine-of-triggers": {
          "triggers": [
            {
              "label": "After Image",
              "event": "hit",
              "filter": [
                {
                  "o": "NOT",
                  "v": {
                    "k": "statuses.blinded",
                    "o": "gte",
                    "v": 1
                  }
                },
                {
                  "o": "NOT",
                  "v": {
                    "k": "attributes.senses.ranges.blindsight",
                    "o": "gt",
                    "v": 0
                  }
                },
                {
                  "o": "NOT",
                  "v": {
                    "k": "attributes.senses.ranges.truesight",
                    "o": "gt",
                    "v": 0
                  }
                }
              ],
              "action": {
                "type": "duplicates",
                "count": 1,
                "threshold": 3
              },
              "then": "keep"
            },
            {
              "label": "After Image",
              "event": "moved",
              "filter": [
                {
                  "k": "ownTurn",
                  "v": true
                },
                {
                  "k": "movedThisTurn",
                  "o": "gte",
                  "v": 15
                }
              ],
              "action": {
                "type": "restoreDuplicates",
                "count": 1
              },
              "reason": "moved 15+ ft on their turn"
            },
            {
              "label": "After Image",
              "event": "statusGained",
              "filter": [
                {
                  "k": "gainedStatuses",
                  "o": "has",
                  "v": "dodging"
                }
              ],
              "action": {
                "type": "restoreDuplicates",
                "count": 1
              },
              "reason": "takes the Dodge action"
            }
          ]
        }
